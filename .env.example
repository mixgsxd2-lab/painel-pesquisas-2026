# Copie para .env e preencha. NUNCA publique o .env.

# Endereço público do site (usado em canonical, sitemap, Open Graph)
SITE_URL=https://www.seudominio.com.br
# Chave longa e aleatória (ex.: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=troque-por-uma-chave-aleatoria
# Senha do /admin (vazio = /admin desligado)
ADMIN_PASSWORD=
# Onde ficam banco, logs, sitemap e imagens geradas (em produção: o disco persistente)
DATA_DIR=./data

# E-mails
EMAIL_CONTATO=correcoes@seudominio.com.br
EMAIL_DONO=voce@seudominio.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1

# Busca na web (use pelo menos um; Brave é o recomendado)
BRAVE_API_KEY=
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BUSCA_DUCKDUCKGO=1
MAX_PESQUISAS_POR_RODADA=40
MAX_URLS_POR_PESQUISA=8

# Verificação de propriedade (Search Console / Bing Webmaster) via meta tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Atualização disparada por visitas (sem agendador)
AUTO_ATUALIZAR=1
INTERVALO_PIPELINE_MIN=60
INTERVALO_APURACAO_MIN=2
# INICIO_APURACAO=2026-10-25T17:00:00
